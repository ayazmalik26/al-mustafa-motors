# ─────────────────────────────────────────────────────────────
# Al-Mustafa Motors — environment variables
# Copy to `.env` (npm run setup does this for you) and adjust.
# Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ---- API server ----
NODE_ENV=development
# API port. A dedicated name so a generic PORT set by your shell or tools cannot move the API
# (the website dev server expects it on 3000). PORT is still honoured when API_PORT is unset (e.g. on PaaS hosts).
API_PORT=3000
# Public URL of the website. Used for canonical URLs, sitemap, Open Graph and CORS.
FRONTEND_URL=http://localhost:4200
# Extra comma-separated origins allowed by CORS (optional).
CORS_ORIGINS=

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://almustafa:almustafa@localhost:5432/almustafa?schema=public
# Optional direct (non-pooled) connection used by Prisma migrations. Needed with hosted Postgres that
# gives you a pooled DATABASE_URL (e.g. Neon "-pooler" hosts). Leave empty locally.
DIRECT_DATABASE_URL=
# Separate database used by the backend API test suite (it is wiped on every run).
TEST_DATABASE_URL=postgresql://almustafa:almustafa@localhost:5432/almustafa_test?schema=public

# ---- Authentication ----
# Use a long random value in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
# Session cookie is sent only over HTTPS when true. Keep false for plain-http localhost.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API, so rate limits see real visitor IPs:
# 0 = none (local), 1 = one proxy (nginx/Caddy/load balancer), 2 = Netlify edge → Render.
TRUST_PROXY=0
# Rate limiting on the API (login, enquiry and sell-request endpoints have stricter limits). Keep enabled in production.
RATE_LIMIT_ENABLED=true

# ---- Development admin account (created by the seed script) ----
# DEVELOPMENT ONLY — change before production.
SEED_ADMIN_EMAIL=admin@almustafamotors.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---- Business defaults ----
# Written into the settings table the first time the database is seeded.
# After that, edit them in /admin/settings (the database is the source of truth).
BUSINESS_NAME=Al-Mustafa Motors
WHATSAPP_NUMBER=+923368440890
BUSINESS_PHONE=+923118382992
GOOGLE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Al-Mustafa+Motors+Main+University+Road+Karachi

# ---- Image storage ----
# local      = files on disk under UPLOAD_DIR, served by the API at PUBLIC_UPLOAD_BASE_URL.
# cloudinary = Cloudinary CDN (use for Netlify/Render and any host without a persistent disk).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
MAX_UPLOAD_MB=8
# Cloudinary (only when STORAGE_DRIVER=cloudinary). Either the single URL from the Cloudinary
# dashboard ("API environment variable": cloudinary://<api_key>:<api_secret>@<cloud_name>)…
CLOUDINARY_URL=
# …or the three separate values:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary media library.
CLOUDINARY_FOLDER=al-mustafa-motors

# ---- Angular SSR server (production: npm run start:prod / Docker) ----
# Where the SSR server reaches the API (server-to-server). Browser requests use /api on the same origin.
API_INTERNAL_URL=http://localhost:3000
# Port of the production SSR server.
SSR_PORT=4000
# Hostnames the website may be served under (Host header allow-list). REQUIRED in production,
# e.g. NG_ALLOWED_HOSTS=almustafamotors.pk,www.almustafamotors.pk  (empty = localhost only).
NG_ALLOWED_HOSTS=
# Proxy headers the SSR server may trust when behind a reverse proxy, e.g. x-forwarded-host,x-forwarded-proto
NG_TRUST_PROXY_HEADERS=
# The SSR server proxies /api, /uploads, /sitemap.xml and /robots.txt to API_INTERNAL_URL.
# Set to false if your reverse proxy routes those paths to the API itself.
API_PROXY=true

# ---- Docker Compose only ----
# Public URL of the site when running `docker compose up` (used for canonical URLs/CORS).
PUBLIC_SITE_URL=http://localhost:4000
